<?xml version="1.0"?>
<sdf version="1.10">
  <model name="mobile_sorting_robot">

    <!-- ========================================================= -->
    <!-- Kinematic omnidirectional base: direct model velocity     -->
    <!-- ========================================================= -->
    <plugin filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
      <topic>/model/mobile_sorting_robot/cmd_vel</topic>
    </plugin>

    <!-- Ground-truth odometry publisher for simulation / ROS bridge -->
    <plugin filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/model/mobile_sorting_robot/odometry</odom_topic>
      <tf_topic>/model/mobile_sorting_robot/tf</tf_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- ========================================================= -->
    <!-- Base link: three-layer chassis + visible IMU + IMU sensor -->
    <!-- ========================================================= -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <mass>4.0</mass>
        <inertia>
          <ixx>0.030</ixx>
          <iyy>0.045</iyy>
          <izz>0.055</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Simple collision envelope for the upper chassis only.
           Keep it above the wheels to avoid ground / wheel contact jitter. -->
      <collision name="base_collision">
        <pose>0 0 0.125 0 0 0</pose>
        <geometry>
          <box>
            <size>0.38 0.28 0.080</size>
          </box>
        </geometry>
      </collision>

      <!-- Bottom deck: lower hardware layer -->
      <visual name="bottom_deck">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.40 0.30 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>

      <!-- Middle deck: LiDAR support layer -->
      <visual name="middle_deck">
        <pose>0 0 0.120 0 0 0</pose>
        <geometry>
          <box>
            <size>0.36 0.26 0.022</size>
          </box>
        </geometry>
        <material>
          <ambient>0.16 0.32 0.58 1</ambient>
          <diffuse>0.16 0.32 0.58 1</diffuse>
        </material>
      </visual>

      <!-- Top deck: dual cameras + arm layer -->
      <visual name="top_deck">
        <pose>0 0 0.230 0 0 0</pose>
        <geometry>
          <box>
            <size>0.32 0.23 0.020</size>
          </box>
        </geometry>
        <material>
          <ambient>0.38 0.38 0.38 1</ambient>
          <diffuse>0.38 0.38 0.38 1</diffuse>
        </material>
      </visual>

      <!-- Four metal standoffs -->
      <visual name="front_left_standoff">
        <pose>0.155 0.110 0.125 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.010</radius>
            <length>0.210</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.82 0.82 0.82 1</ambient>
          <diffuse>0.82 0.82 0.82 1</diffuse>
        </material>
      </visual>

      <visual name="front_right_standoff">
        <pose>0.155 -0.110 0.125 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.010</radius>
            <length>0.210</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.82 0.82 0.82 1</ambient>
          <diffuse>0.82 0.82 0.82 1</diffuse>
        </material>
      </visual>

      <visual name="rear_left_standoff">
        <pose>-0.155 0.110 0.125 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.010</radius>
            <length>0.210</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.82 0.82 0.82 1</ambient>
          <diffuse>0.82 0.82 0.82 1</diffuse>
        </material>
      </visual>

      <visual name="rear_right_standoff">
        <pose>-0.155 -0.110 0.125 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.010</radius>
            <length>0.210</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.82 0.82 0.82 1</ambient>
          <diffuse>0.82 0.82 0.82 1</diffuse>
        </material>
      </visual>

      <!-- Visible IMU module on bottom layer -->
      <visual name="imu_board_visual">
        <pose>0.045 0 0.058 0 0 0</pose>
        <geometry>
          <box>
            <size>0.075 0.055 0.014</size>
          </box>
        </geometry>
        <material>
          <ambient>0.45 0.12 0.85 1</ambient>
          <diffuse>0.45 0.12 0.85 1</diffuse>
        </material>
      </visual>

      <visual name="imu_chip_visual">
        <pose>0.045 0 0.068 0 0 0</pose>
        <geometry>
          <box>
            <size>0.026 0.026 0.006</size>
          </box>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>

      <visual name="imu_axis_x_visual">
        <pose>0.082 0 0.075 0 0 0</pose>
        <geometry>
          <box>
            <size>0.030 0.006 0.006</size>
          </box>
        </geometry>
        <material>
          <ambient>1.00 0.05 0.05 1</ambient>
          <diffuse>1.00 0.05 0.05 1</diffuse>
        </material>
      </visual>

      <visual name="imu_axis_y_visual">
        <pose>0.045 0.030 0.075 0 0 0</pose>
        <geometry>
          <box>
            <size>0.006 0.030 0.006</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 1.00 0.05 1</ambient>
          <diffuse>0.05 1.00 0.05 1</diffuse>
        </material>
      </visual>

      <!-- Front direction marker: +X -->
      <visual name="front_marker">
        <pose>0.215 0 0.145 0 0 0</pose>
        <geometry>
          <box>
            <size>0.035 0.15 0.014</size>
          </box>
        </geometry>
        <material>
          <ambient>1.00 0.45 0.02 1</ambient>
          <diffuse>1.00 0.45 0.02 1</diffuse>
        </material>
      </visual>

      <!-- IMU data source -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/model/mobile_sorting_robot/imu</topic>
      </sensor>
    </link>

    <!-- ========================================================= -->
    <!-- YDLIDAR X3-like 2D lidar on middle deck, pushed forward  -->
    <!-- ========================================================= -->
    <link name="lidar_link">
      <!-- x=0.145 makes the lidar clearly forward; slightly protrudes from the deck -->
      <pose>0.145 0 0.170 0 0 0</pose>

      <inertial>
        <mass>0.18</mass>
        <inertia>
          <ixx>0.00025</ixx>
          <iyy>0.00025</iyy>
          <izz>0.00025</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="lidar_black_base">
        <pose>0 0 -0.020 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.058</radius>
            <length>0.018</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
        </material>
      </visual>

      <visual name="lidar_white_body">
        <pose>0 0 0.000 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.047</radius>
            <length>0.032</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.88 0.88 0.82 1</ambient>
          <diffuse>0.88 0.88 0.82 1</diffuse>
        </material>
      </visual>

      <visual name="lidar_black_top">
        <pose>0 0 0.022 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.036</radius>
            <length>0.010</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.01 0.01 0.01 1</ambient>
          <diffuse>0.01 0.01 0.01 1</diffuse>
        </material>
      </visual>

      <visual name="lidar_front_window">
        <pose>0.047 0 0.004 0 1.5708 0</pose>
        <geometry>
          <box>
            <size>0.012 0.050 0.014</size>
          </box>
        </geometry>
        <material>
          <ambient>0.00 0.00 0.00 1</ambient>
          <diffuse>0.00 0.00 0.00 1</diffuse>
        </material>
      </visual>

      <collision name="lidar_collision">
        <geometry>
          <cylinder>
            <radius>0.058</radius>
            <length>0.060</length>
          </cylinder>
        </geometry>
      </collision>

      <sensor name="gpu_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>/model/mobile_sorting_robot/scan</topic>

        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926</min_angle>
              <max_angle>3.1415926</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- ========================================================= -->
    <!-- Left RGB camera above lidar, angled outward              -->
    <!-- ========================================================= -->
    <link name="left_rgb_camera_link">
      <pose>0.115 0.060 0.285 0 0.18 0.25</pose>

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="left_camera_body">
        <geometry>
          <box>
            <size>0.060 0.045 0.036</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.20 0.95 1</ambient>
          <diffuse>0.05 0.20 0.95 1</diffuse>
        </material>
      </visual>

      <visual name="left_camera_lens">
        <pose>0.036 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
        </material>
      </visual>

      <visual name="left_camera_mount">
        <pose>-0.034 0 -0.040 0 0 0</pose>
        <geometry>
          <box>
            <size>0.030 0.038 0.055</size>
          </box>
        </geometry>
        <material>
          <ambient>0.78 0.78 0.78 1</ambient>
          <diffuse>0.78 0.78 0.78 1</diffuse>
        </material>
      </visual>

      <collision name="left_camera_collision">
        <geometry>
          <box>
            <size>0.060 0.045 0.036</size>
          </box>
        </geometry>
      </collision>

      <sensor name="left_rgb_camera" type="camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <topic>/model/mobile_sorting_robot/left_camera</topic>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <joint name="left_rgb_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>left_rgb_camera_link</child>
    </joint>

    <!-- ========================================================= -->
    <!-- Right RGB camera above lidar, angled outward             -->
    <!-- ========================================================= -->
    <link name="right_rgb_camera_link">
      <pose>0.115 -0.060 0.285 0 0.18 -0.25</pose>

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="right_camera_body">
        <geometry>
          <box>
            <size>0.060 0.045 0.036</size>
          </box>
        </geometry>
        <material>
          <ambient>0.20 0.85 1.00 1</ambient>
          <diffuse>0.20 0.85 1.00 1</diffuse>
        </material>
      </visual>

      <visual name="right_camera_lens">
        <pose>0.036 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
        </material>
      </visual>

      <visual name="right_camera_mount">
        <pose>-0.034 0 -0.040 0 0 0</pose>
        <geometry>
          <box>
            <size>0.030 0.038 0.055</size>
          </box>
        </geometry>
        <material>
          <ambient>0.78 0.78 0.78 1</ambient>
          <diffuse>0.78 0.78 0.78 1</diffuse>
        </material>
      </visual>

      <collision name="right_camera_collision">
        <geometry>
          <box>
            <size>0.060 0.045 0.036</size>
          </box>
        </geometry>
      </collision>

      <sensor name="right_rgb_camera" type="camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <topic>/model/mobile_sorting_robot/right_camera</topic>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <joint name="right_rgb_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>right_rgb_camera_link</child>
    </joint>

    <!-- ========================================================= -->
    <!-- 6-DOF simplified arm: controllable visual manipulator     -->
    <!-- ========================================================= -->

    <link name="arm_base_link">
      <pose>-0.045 0 0.260 0 0 0</pose>
      <inertial>
        <mass>0.30</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="arm_base_visual">
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.55 0.55 0.55 1</diffuse>
        </material>
      </visual>
      <collision name="arm_base_collision">
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="arm_mount_joint" type="fixed">
      <parent>base_link</parent>
      <child>arm_base_link</child>
    </joint>

    <link name="arm_link_1">
      <pose>-0.045 0 0.320 0 0 0</pose>
      <inertial>
        <mass>0.18</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <iyy>0.0005</iyy>
          <izz>0.0005</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="servo_1_visual">
        <geometry>
          <box>
            <size>0.070 0.050 0.045</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.72 0.20 1</ambient>
          <diffuse>0.95 0.72 0.20 1</diffuse>
        </material>
      </visual>
      <collision name="servo_1_collision">
        <geometry>
          <box>
            <size>0.070 0.050 0.045</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="arm_joint_1" type="revolute">
      <parent>arm_base_link</parent>
      <child>arm_link_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14</lower>
          <upper>3.14</upper>
          <effort>5</effort>
          <velocity>1.5</velocity>
        </limit>
      </axis>
    </joint>

    <link name="arm_link_2">
      <pose>-0.020 0 0.390 0 0.35 0</pose>
      <inertial>
        <mass>0.18</mass>
        <inertia>
          <ixx>0.0006</ixx>
          <iyy>0.0006</iyy>
          <izz>0.0006</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="upper_arm_visual">
        <geometry>
          <box>
            <size>0.035 0.035 0.150</size>
          </box>
        </geometry>
        <material>
          <ambient>0.82 0.82 0.82 1</ambient>
          <diffuse>0.82 0.82 0.82 1</diffuse>
        </material>
      </visual>
      <collision name="upper_arm_collision">
        <geometry>
          <box>
            <size>0.035 0.035 0.150</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="arm_joint_2" type="revolute">
      <parent>arm_link_1</parent>
      <child>arm_link_2</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>5</effort>
          <velocity>1.5</velocity>
        </limit>
      </axis>
    </joint>

    <link name="arm_link_3">
      <pose>0.035 0 0.480 0 0.55 0</pose>
      <inertial>
        <mass>0.16</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <iyy>0.0005</iyy>
          <izz>0.0005</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="forearm_visual">
        <geometry>
          <box>
            <size>0.030 0.030 0.130</size>
          </box>
        </geometry>
        <material>
          <ambient>0.88 0.88 0.88 1</ambient>
          <diffuse>0.88 0.88 0.88 1</diffuse>
        </material>
      </visual>
      <collision name="forearm_collision">
        <geometry>
          <box>
            <size>0.030 0.030 0.130</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="arm_joint_3" type="revolute">
      <parent>arm_link_2</parent>
      <child>arm_link_3</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>4</effort>
          <velocity>1.5</velocity>
        </limit>
      </axis>
    </joint>

    <link name="arm_link_4">
      <pose>0.080 0 0.555 0 0.55 0</pose>
      <inertial>
        <mass>0.10</mass>
        <inertia>
          <ixx>0.0003</ixx>
          <iyy>0.0003</iyy>
          <izz>0.0003</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wrist_1_visual">
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.055</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.95 0.72 0.20 1</ambient>
          <diffuse>0.95 0.72 0.20 1</diffuse>
        </material>
      </visual>
      <collision name="wrist_1_collision">
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.055</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="arm_joint_4" type="revolute">
      <parent>arm_link_3</parent>
      <child>arm_link_4</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-3.14</lower>
          <upper>3.14</upper>
          <effort>2</effort>
          <velocity>2.0</velocity>
        </limit>
      </axis>
    </joint>

    <link name="arm_link_5">
      <pose>0.115 0 0.575 0 0.55 0</pose>
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <iyy>0.0002</iyy>
          <izz>0.0002</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wrist_2_visual">
        <geometry>
          <box>
            <size>0.050 0.035 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.70 0.70 0.70 1</ambient>
          <diffuse>0.70 0.70 0.70 1</diffuse>
        </material>
      </visual>
      <collision name="wrist_2_collision">
        <geometry>
          <box>
            <size>0.050 0.035 0.035</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="arm_joint_5" type="revolute">
      <parent>arm_link_4</parent>
      <child>arm_link_5</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>2</effort>
          <velocity>2.0</velocity>
        </limit>
      </axis>
