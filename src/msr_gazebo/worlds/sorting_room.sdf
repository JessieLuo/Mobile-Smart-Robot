<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="sorting_room">

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.78 0.84 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_walls">
      <static>true</static>

      <link name="wall_north">
        <pose>0 3.0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>6.0 0.08 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.08 1.0</size></box></geometry>
          <material><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_south">
        <pose>0 -3.0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>6.0 0.08 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.08 1.0</size></box></geometry>
          <material><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_east">
        <pose>3.0 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.08 6.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 6.0 1.0</size></box></geometry>
          <material><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>

      <link name="wall_west">
        <pose>-3.0 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.08 6.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 6.0 1.0</size></box></geometry>
          <material><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://mobile_sorting_robot</uri>
      <pose>0 0 0.12 0 0 0</pose>
    </include>

    <include>
      <uri>model://red_block</uri>
      <pose>1.0 0.7 0.03 0 0 0</pose>
    </include>

    <include>
      <uri>model://green_block</uri>
      <pose>1.4 -0.6 0.03 0 0 0</pose>
    </include>

    <include>
      <uri>model://blue_block</uri>
      <pose>-0.8 1.2 0.03 0 0 0</pose>
    </include>

    <include>
      <uri>model://red_bin</uri>
      <pose>2.2 2.2 0.15 0 0 0</pose>
    </include>

    <include>
      <uri>model://green_bin</uri>
      <pose>2.2 1.6 0.15 0 0 0</pose>
    </include>

    <include>
      <uri>model://blue_bin</uri>
      <pose>2.2 1.0 0.15 0 0 0</pose>
    </include>

  </world>
</sdf>